# SafeRoute Environment Configuration
# Copy this file to .env and fill in your Supabase credentials:
# cp .env.example .env

# Your Supabase Project URL (found in Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (safe to use in frontend code)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here
